<UserControl x:Class="CajaApp.UI.Views.Cliente.ClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CajaApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:ClienteViewModel}">
    
    <UserControl.DataContext>
        <viewModels:ClienteViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0">
            <!-- Search Panel -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Buscar:" Style="{StaticResource FormLabelStyle}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding BusquedaNombre}" 
                             Style="{StaticResource MaterialTextBoxStyle}" 
                             Watermark="Nombre o apellidos" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="🔍 Buscar" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding BuscarAsyncCommand}"/>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="👤 Nuevo Cliente" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ShowCreateDialogCommand}" Margin="0,0,10,0"/>
                <Button Content="📝 Editar" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ShowEditDialogCommand}" Margin="0,0,10,0"/>
                <Button Content="🗑️ Eliminar" Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding ShowDeleteDialogCommand}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Data Grid -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <DataGrid ItemsSource="{Binding Clientes}" SelectedItem="{Binding SelectedCliente}"
                          Style="{StaticResource MaterialDataGridStyle}" 
                          CanUserSortColumns="True" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto"/>
                        <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="*"/>
                        <DataGridTextColumn Header="Creación" Binding="{Binding FechaCreacion, StringFormat=g}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Create Dialog -->
            <Border Visibility="{Binding DialogoCrearVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource DialogStyle}" Background="White">
                <StackPanel>
                    <TextBlock Text="Nuevo Cliente" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Content="Nombre:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Nombre}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="1" Content="Apellidos:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Apellidos}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="2" Content="Email:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Email}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="3" Content="Teléfono:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Telefono}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="4" Content="Dirección:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding Direccion}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseDialogsCommand}" Margin="0,0,10,0"/>
                        <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CreateAsyncCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Edit Dialog -->
            <Border Visibility="{Binding DialogoEditarVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource DialogStyle}" Background="White">
                <StackPanel>
                    <TextBlock Text="Editar Cliente" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Content="Nombre:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Nombre}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="1" Content="Apellidos:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Apellidos}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="2" Content="Email:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Email}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="3" Content="Teléfono:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Telefono}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>

                        <Label Grid.Column="0" Grid.Row="4" Content="Dirección:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding Direccion}" 
                                 Style="{StaticResource MaterialTextBoxStyle}" Margin="0,0,0,8"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseDialogsCommand}" Margin="0,0,10,0"/>
                        <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding UpdateAsyncCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Delete Confirmation Dialog -->
            <Border Visibility="{Binding DialogoConfirmarVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource DialogStyle}" Background="White">
                <StackPanel>
                    <TextBlock Text="¿Eliminar Cliente?" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Esta acción no se puede deshacer." 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseDialogsCommand}" Margin="0,0,10,0"/>
                        <Button Content="Eliminar" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteAsyncCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
